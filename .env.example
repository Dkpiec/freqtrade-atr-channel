# Freqtrade ATR_CHANNEL_2H — environment variables
# Copy to .env and fill in your values before running.

# Telegram notifications (required when telegram.enabled=true in config.json)
FREQTRADE_TELEGRAM_TOKEN=your_telegram_bot_token_here
FREQTRADE_TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Binance API credentials (leave empty for dry-run)
FREQTRADE_BINANCE_API_KEY=
FREQTRADE_BINANCE_API_SECRET=