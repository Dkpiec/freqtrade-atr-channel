{
    "trading_mode": "futures",
    "margin_mode": "isolated",
    "max_open_trades": 4,
    "stake_currency": "USDT",
    "stake_amount": "unlimited",
    "tradable_balance_ratio": 0.99,
    "dry_run": false,
    "cancel_open_orders_on_exit": false,
    "exchange": {
        "name": "binance",
        "key": "__BINANCE_KEY_PLACEHOLDER__",
        "secret": "__BINANCE_SECRET_PLACEHOLDER__",
        "ccxt_config": {
            "enableRateLimit": true
        },
        "pair_whitelist": [
            "TRX/USDT:USDT"
        ],
        "pair_blacklist": []
    },
    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exit_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "strategy": "ATR_CHANNEL_2H",
    "timeframe": "2h",
    "internals": {
        "process_throttle_secs": 300
    },
    "telegram": {
        "enabled": true,
        "token": "FREQTRADE_TELEGRAM_TOKEN",
        "chat_id": "FREQTRADE_TELEGRAM_CHAT_ID",
        "notification_settings": {
            "status": "on",
            "warning": "on",
            "startup": "on",
            "buy": "on",
            "sell": "on",
            "buy_cancel": "on",
            "sell_cancel": "on",
            "buy_fill": "on",
            "sell_fill": "on"
        }
    },
    "api_server": {
        "enabled": false,
        "listen_ip_address": "0.0.0.0",
        "listen_port": 8080,
        "verbosity": "error",
        "enable_openapi": false,
        "jwt_secret_key": "atr-channel-2h-jwt-secret-key-2026-minimum-32-chars",
        "CORS_origins": [],
        "username": "",
        "password": ""
    },
    "bot_name": "atr_channel_2h",
    "initial_state": "running",
    "force_entry_enable": false,
    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },
    "order_types": {
        "entry": "limit",
        "exit": "limit",
        "stoploss": "market",
        "stoploss_on_exchange": true
    },
    "order_time_in_force": {
        "entry": "GTC",
        "exit": "GTC"
    }
}